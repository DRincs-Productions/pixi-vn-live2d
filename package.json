{
  "name": "@drincs/pixi-vn-live2d",
  "description": "Live2d integration for Pixi'VN",
  "version": "1.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --config tsup.config.ts",
    "lint": "biome lint",
    "check": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "test:cdn": "npm run build && node scripts/test-pencode-local.mjs",
    "docs": "typedoc",
    "playground:install": "npm ci -w playground",
    "playground:dev": "npm run build && npm run dev -w playground",
    "playground:preview": "npm run build && npm run build -w playground && npm run preview -w playground",
    "skills:validate": "node scripts/validate-skills.mjs",
    "generate-live2d-options-schema": "node scripts/generate-live2d-options-schema.mjs && biome format --write src/ink/live2d-options-schema.generated.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./ink": {
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.mjs",
      "require": "./dist/ink.cjs",
      "default": "./dist/ink.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "ink": [
        "./dist/ink.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@drincs/pixi-vn-ink": "^1.1.8",
    "@drincs/pixi-vn-json": "^1.13.17",
    "jsdom": "^27.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@drincs/pixi-vn": ">=1.5.13",
    "@drincs/pixi-vn-ink": ">=1.1.6",
    "untitled-pixi-live2d-engine": "^1.3.5",
    "zod": ">=4.4.0"
  },
  "peerDependenciesMeta": {
    "@drincs/pixi-vn-ink": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "keywords": [
    "game",
    "js",
    "novel",
    "pixi",
    "pixi-vn",
    "visual",
    "visual-novel",
    "live2d"
  ]
}
